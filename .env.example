# Copia este archivo a .env y completá los valores.
TELEGRAM_TOKEN=123456:ABC-your-bot-token
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_MS=30000
MISTRAL_RETRIES=2
DB_PATH=./data/routine-bot.db
# Ids de Telegram (separados por comas) con permiso para usar el bot. Vacío o sin definir = entra todo.
ALLOWED_TELEGRAM_IDS=
POLL_SECONDS=30
# Cada cuántos minutos chequeo jobs en waiting para avisarte (0 desactiva los recordatorios).
REMINDER_MINUTES=60
# Antigüedad mínima (en horas) de un job waiting para que te avise.
REMINDER_AFTER_HOURS=6