# Copia este archivo a .env y completá los valores.
TELEGRAM_TOKEN=123456:ABC-your-bot-token
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_MS=30000
MISTRAL_RETRIES=2
DB_PATH=./data/routine-bot.db
# Ids de Telegram (separados por comas) con permiso para usar el bot. Vacío o sin definir = entra todo.
ALLOWED_TELEGRAM_IDS=
POLL_SECONDS=30
# Cada cuántos minutos chequeo jobs en waiting para avisarte (0 desactiva los recordatorios).
REMINDER_MINUTES=60
# Antigüedad mínima (en horas) de un job waiting para que te avise.
REMINDER_AFTER_HOURS=6
# Resumen semanal: día (0 domingo … 6 sábado) y hora HH:MM. Dejá STATS_HHMM vacío para desactivar.
STATS_DAY=1
STATS_HHMM=09:00
# Tu id de Telegram: si getUpdates falla varias veces seguidas, te aviso acá (vacío = sin alertas).
ADMIN_TELEGRAM_ID=# Ingest por IMAP (opcional): cuentas a chequear, en JSON. Cada cuenta necesita host, user, pass y telegramId.
# Ej.: IMAP_ACCOUNTS=[{"name":"pedidos","host":"imap.gmail.com","port":993,"tls":true,"user":"pedidos@ejemplo.com","pass":"tu-app-password","mailbox":"INBOX","telegramId":123456789}]
# Vacío o sin definir = sin ingest por email.
IMAP_ACCOUNTS=
# Cada cuántos segundos chequeo las casillas IMAP.
IMAP_POLL_SECONDS=60
